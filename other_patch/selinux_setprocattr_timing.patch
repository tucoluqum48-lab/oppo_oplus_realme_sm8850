--- a/security/selinux/hooks.c
+++ b/security/selinux/hooks.c
@@ -6461,10 +6461,26 @@
 			error = security_context_to_sid_force(value, size,
 							&sid);
 		}
 		if (error)
 			return error;
+	} else if (size >= 1 && str[0] == '\n') {
+		/*
+		 * Timing equalization: the branch above runs a full context parse
+		 * and fails deep in the type lookup. A newline-prefixed value skips
+		 * that work, which makes /proc/self/attr/current timing probes
+		 * trivially distinguishable.
+		 *
+		 * Parsing a mutated copy of the caller's string is not enough - it
+		 * can bail out at the first field. Use a canonical, well-formed but
+		 * unrepresentable context so the same depth is always traversed.
+		 */
+		static const char dummy_ctx[] = "u:r:susfs_timing_dummy:s0:c0";
+		u32 dummy_sid = 0;
+
+		(void)security_context_to_sid(dummy_ctx, sizeof(dummy_ctx) - 1,
+					      &dummy_sid, GFP_KERNEL);
 	}
 
 	new = prepare_creds();
 	if (!new)
 		return -ENOMEM;
