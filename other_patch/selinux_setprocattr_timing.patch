--- a/security/selinux/hooks.c
+++ b/security/selinux/hooks.c
@@ -6461,10 +6461,30 @@
 			error = security_context_to_sid_force(value, size,
 							&sid);
 		}
 		if (error)
 			return error;
+	} else if (size >= 1 && str[0] == '\n') {
+		/*
+		 * Timing equalization: the branch above runs a full context parse
+		 * and fails in the type lookup, while a newline-prefixed value skips
+		 * that work entirely - which makes /proc/self/attr/current timing
+		 * probes trivially distinguishable.
+		 *
+		 * Pay the same parse on a canonical, well-formed but unrepresentable
+		 * context, plus the credential allocation the original hook path
+		 * performs, so both branches cost roughly the same.
+		 */
+		static const char dummy_ctx[] = "u:r:susfs_timing_dummy:s0:c0";
+		struct cred *tmp_cred;
+		u32 dummy_sid = 0;
+
+		(void)security_context_to_sid(dummy_ctx, sizeof(dummy_ctx) - 1,
+					      &dummy_sid, GFP_KERNEL);
+		tmp_cred = prepare_creds();
+		if (tmp_cred)
+			abort_creds(tmp_cred);
 	}
 
 	new = prepare_creds();
 	if (!new)
 		return -ENOMEM;
