From: workspace <workspace@localhost>
Subject: [PATCH] susfs: hide selected kernel modules from /proc/modules and /proc/kallsyms

内建版 hide_modules，等价于 susfs4ksu-for-lkm 的可加载模块实现：
  - kernel/module/procfs.c  m_show()  按 module->name 跳过整行（所有读者，含 root）
  - kernel/kallsyms.c       s_show()  按 module_name 跳过整行（模块符号一并消失）
  - /sys/module/<name> 由本模块置 strict 位，对所有非 root 生效（root 仍可见）

前置：susfs 主补丁 50_add_susfs_in_gki-*.patch 已应用（本补丁排在其后）。
diff --git a/fs/oplus_mem_zone.c b/fs/oplus_mem_zone.c
new file mode 100644
index 000000000..0000000
--- /dev/null
+++ b/fs/oplus_mem_zone.c
@@ -0,0 +1,704 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * oplus_mem_zone.c - 按名字把指定内核模块从 /proc/modules 与 /proc/kallsyms 里抹掉
+ *
+ * 与 susfs4ksu-for-lkm 的 hide_modules 等价，但走源码：没有 .ko、没有运行时 hook、
+ * 没有模块条目需要自己擦。
+ *
+ *   1) /proc/modules  : kernel/module/procfs.c 的 m_show() 开头 return 0
+ *                        -> 所有读者（含 root）都看不到这一行
+ *   2) /proc/kallsyms : kernel/kallsyms.c 的 s_show() 开头按 module_name 过滤
+ *                        -> 该模块的 __kstrtab_* / *_init 等符号一并消失
+ *   3) /sys/module/<name> : 不在这里做。用户态用
+ *                        ksu_susfs add_sus_path /sys/module/<name>
+ *                        效果为「非 root 得到 ENOENT，root 仍可读」
+ *
+ * 名单有两个来源，取并集：
+ *   - 编译期常量 susfs_hidden_modules[]：开机即生效，无需用户态配合
+ *   - 运行时表：写 /proc/oplus_mem_zone（0600，仅 root）
+ *       echo "add zygisk_loader" > /proc/oplus_mem_zone
+ *       echo "del zygisk_loader" > /proc/oplus_mem_zone
+ *       echo clear               > /proc/oplus_mem_zone   # 只清运行时表
+ *       cat /proc/oplus_mem_zone                          # 看两边的现状
+ *     不定义 SUSFS_HIDE_MODULES_NO_CTL 时才编译这个节点。
+ */
+
+#include <linux/kernel.h>
+#include <linux/init.h>
+#include <linux/module.h>	/* MODULE_NAME_LEN */
+#include <linux/string.h>
+#include <linux/spinlock.h>
+#include <linux/atomic.h>
+#include <linux/fs.h>		/* set_bit + inode->i_mapping */
+#include <linux/namei.h>	/* kern_path */
+#include <linux/workqueue.h>	/* 延迟同步 /sys/module 规则 */
+#include <linux/dcache.h>	/* d_invalidate */
+#include <linux/vmalloc.h>	/* vmalloc/vfree */
+#include <linux/fcntl.h>	/* O_RDONLY / O_NOATIME */
+#include <linux/cred.h>	/* prepare_creds / commit_creds */
+#include <linux/crc32.h>	/* crc32 */
+#include <linux/slab.h>
+#include <linux/oplus_mem_zone.h>
+#include <linux/proc_fs.h>
+#include <linux/seq_file.h>
+#include <linux/uaccess.h>
+#include <linux/capability.h>
+#include <linux/oplus_mem_zone.h>
+
+/*
+ * 编译期名单。名字必须精确匹配 struct module->name，也就是
+ *   lsmod 第一列 / cat /proc/modules 第一列（不带 .ko，'-' 已转成 '_'）
+ */
+/*
+ * 通用版：编译期名单留空，靠用户态脚本运行时登记（/data/adb/service.d/96-hide-ko.sh
+ * 扫描 /data/adb/modules 下的 .ko）。占位项永远不会匹配真实模块名（模块名不允许带点），
+ * 只为避免零长数组这种编译器扩展。
+ *
+ * 想固定几个模块、开机瞬间就生效的话，在这里加名字即可，例如：
+ *	"qpace_drv",
+ *	"qpace_zram",
+ */
+/* 上游 SUSFS 2.4.0 提供的内核态入口（由本补丁在 fs/susfs.c 中补充实现） */
+extern int susfs_kernel_set_priority_apps(const char *apps);
+extern int susfs_kernel_set_sus_path_apps(const char *apps);
+
+static const char *const susfs_hidden_modules[] = {
+	"none.invalid",
+};
+
+#ifndef SUSFS_HIDE_MODULES_RT_MAX
+#define SUSFS_HIDE_MODULES_RT_MAX 32
+#endif
+
+static char susfs_hidden_rt[SUSFS_HIDE_MODULES_RT_MAX][MODULE_NAME_LEN];
+static int susfs_hidden_rt_nr;
+static DEFINE_SPINLOCK(susfs_hidden_lock);
+
+/* 命中统计：/proc/oplus_mem_zone 里可读，用来确认过滤真的在生效 */
+static atomic_t susfs_n_mod_skipped = ATOMIC_INIT(0);
+static atomic_t susfs_n_sym_skipped = ATOMIC_INIT(0);
+static atomic_t susfs_n_symname_skipped = ATOMIC_INIT(0);
+static atomic_t susfs_n_sysfs_marked = ATOMIC_INIT(0);
+
+/* 中断/seq_file 上下文都可能调用：不分配、不睡眠 */
+/*
+ * /sys/module/<name> 的隐藏：跟 SUSFS 的 sus_path 用同一个位。
+ * 内置 SUSFS 只对外提供 susfs_add_sus_path(void __user **)（要用户态指针），
+ * 内核态拿不到；但隐藏动作本身只是置位，直接做即可。
+ */
+/*
+ * sysfs 的 inode 是会被回收的：置位后如果没人持有，内存压力下 inode 被 evict，
+ * 下一次查找会生成新 inode，位就没了 —— 表现为「开机时藏住了，几小时后又能看到」。
+ * 所以标记成功后 ihold 持住，解除标记时 iput。
+ */
+#define SUSFS_HELD_MAX	64
+
+static struct inode *susfs_held_inodes[SUSFS_HELD_MAX];
+static int susfs_held_n;
+static DEFINE_MUTEX(susfs_held_lock);
+
+static void susfs_hold_inode(struct inode *inode)
+{
+	int i;
+
+	mutex_lock(&susfs_held_lock);
+	for (i = 0; i < susfs_held_n; i++) {
+		if (susfs_held_inodes[i] == inode) {
+			mutex_unlock(&susfs_held_lock);
+			return;
+		}
+	}
+	if (susfs_held_n < SUSFS_HELD_MAX) {
+		ihold(inode);
+		susfs_held_inodes[susfs_held_n++] = inode;
+	}
+	mutex_unlock(&susfs_held_lock);
+}
+
+static void susfs_release_inode(struct inode *inode)
+{
+	int i;
+
+	mutex_lock(&susfs_held_lock);
+	for (i = 0; i < susfs_held_n; i++) {
+		if (susfs_held_inodes[i] == inode) {
+			susfs_held_inodes[i] = susfs_held_inodes[susfs_held_n - 1];
+			susfs_held_inodes[--susfs_held_n] = NULL;
+			mutex_unlock(&susfs_held_lock);
+			iput(inode);
+			return;
+		}
+	}
+	mutex_unlock(&susfs_held_lock);
+}
+
+static void susfs_hide_mark_path(const char *path, bool hide)
+{
+	struct inode *inode;
+	struct path p;
+
+	if (!path || !path[0])
+		return;
+	if (kern_path(path, LOOKUP_FOLLOW, &p))
+		return;		/* 模块还没加载，下次再试 */
+	inode = d_backing_inode(p.dentry);
+	if (inode && inode->i_mapping) {
+		if (hide) {
+			set_bit(AS_FLAGS_SUS_PATH_STRICT, &inode->i_mapping->flags);
+			atomic_inc(&susfs_n_sysfs_marked);
+			susfs_hold_inode(inode);	/* 防止 inode 回收导致位丢失 */
+		} else {
+			clear_bit(AS_FLAGS_SUS_PATH_STRICT, &inode->i_mapping->flags);
+			susfs_release_inode(inode);
+		}
+	}
+	path_put(&p);
+}
+
+/* /sys/module/<name> 的包装 */
+static void susfs_hide_sysfs_mark(const char *name, bool hide)
+{
+	char path[64];
+
+	if (!name || !name[0])
+		return;
+	snprintf(path, sizeof(path), "/sys/module/%s", name);
+	susfs_hide_mark_path(path, hide);
+}
+
+/* 把名单里所有名字的 /sys/module 目录同步一遍 */
+static void susfs_hide_sysfs_sync(void)
+{
+	unsigned long flags;
+
+	char rt[SUSFS_HIDE_MODULES_RT_MAX][MODULE_NAME_LEN];
+	int nr, i;
+
+	for (i = 0; i < ARRAY_SIZE(susfs_hidden_modules); i++)
+		susfs_hide_sysfs_mark(susfs_hidden_modules[i], true);
+
+	spin_lock_irqsave(&susfs_hidden_lock, flags);
+	nr = susfs_hidden_rt_nr;
+	if (nr > SUSFS_HIDE_MODULES_RT_MAX)
+		nr = SUSFS_HIDE_MODULES_RT_MAX;
+	memcpy(rt, susfs_hidden_rt, sizeof(rt[0]) * nr);
+	spin_unlock_irqrestore(&susfs_hidden_lock, flags);
+
+	for (i = 0; i < nr; i++)
+		susfs_hide_sysfs_mark(rt[i], true);
+}
+
+/* 模块可能在开机后才 insmod：补几轮 */
+static void susfs_hide_sysfs_work(struct work_struct *w);
+static DECLARE_DELAYED_WORK(susfs_hide_sysfs_dw, susfs_hide_sysfs_work);
+static int susfs_hide_sysfs_rounds;
+
+static void susfs_hide_sysfs_work(struct work_struct *w)
+{
+	susfs_hide_sysfs_sync();
+	if (++susfs_hide_sysfs_rounds < 4)
+		schedule_delayed_work(&susfs_hide_sysfs_dw, 15 * HZ);
+}
+
+/*
+ * 控制节点的 dentry 可能在开机脚本写入时被缓存（d_invalidate 遇 EBUSY 失败），
+ * 此后非 root 的 stat 会直接命中缓存、绕过 lookup 过滤，最终被 SELinux 判成 EACCES。
+ * 这里在写入后补几轮失效，让缓存真正掉出去。
+ */
+static void susfs_ctl_dentry_work(struct work_struct *w);
+static DECLARE_DELAYED_WORK(susfs_ctl_dentry_dw, susfs_ctl_dentry_work);
+static int susfs_ctl_dentry_rounds;
+
+static void susfs_ctl_dentry_work(struct work_struct *w)
+{
+	struct path p;
+
+	if (!kern_path("/proc/oplus_mem_zone", 0, &p)) {
+		d_invalidate(p.dentry);
+		path_put(&p);
+	}
+
+	if (++susfs_ctl_dentry_rounds < 6)
+		schedule_delayed_work(&susfs_ctl_dentry_dw, 2 * HZ);
+}
+
+static bool susfs_hide_match(const char *name)
+{
+	unsigned long flags;
+	bool hit = false;
+	int i;
+
+	if (!name || !name[0])
+		return false;
+
+	for (i = 0; i < ARRAY_SIZE(susfs_hidden_modules); i++) {
+		if (!strcmp(name, susfs_hidden_modules[i]))
+			return true;
+	}
+
+	spin_lock_irqsave(&susfs_hidden_lock, flags);
+	for (i = 0; i < susfs_hidden_rt_nr; i++) {
+		if (!strcmp(name, susfs_hidden_rt[i])) {
+			hit = true;
+			break;
+		}
+	}
+	spin_unlock_irqrestore(&susfs_hidden_lock, flags);
+
+	return hit;
+}
+
+/* /proc/modules 的 m_show() 调用：命中就计一条 */
+bool susfs_hide_module_name(const char *name)
+{
+	if (susfs_hide_match(name)) {
+		atomic_inc(&susfs_n_mod_skipped);
+		return true;
+	}
+	return false;
+}
+
+/*
+ * 符号名过滤：处理"符号定义在别的模块里"的情况。
+ * 例：qpace_drv 的压缩函数被厂商 zram.ko 包了一层，
+ *     符号归属变成 [zram]，按模块名抓不到，只能按符号名抹。
+ * 只认 qpace 这一个前缀串，避免误伤无关符号。
+ */
+static const char *const susfs_hidden_sym_parts[] = {
+	"qpace",	/* 绿厂 QPaCE 硬件加速相关的符号；其他设备上匹配不到，无副作用 */
+};
+
+static bool susfs_hide_sym_name_match(const char *name)
+{
+	int i;
+
+	if (!name || !name[0])
+		return false;
+
+	for (i = 0; i < ARRAY_SIZE(susfs_hidden_sym_parts); i++) {
+		if (strstr(name, susfs_hidden_sym_parts[i]))
+			return true;
+	}
+	return false;
+}
+
+bool susfs_hide_symbol_name(const char *name)
+{
+	if (susfs_hide_sym_name_match(name)) {
+		atomic_inc(&susfs_n_symname_skipped);
+		return true;
+	}
+	return false;
+}
+
+/* /proc/kallsyms 的 s_show() 调用：只对模块符号计一条 */
+bool susfs_hide_module_symbol(const char *module_name)
+{
+	if (susfs_hide_match(module_name)) {
+		atomic_inc(&susfs_n_sym_skipped);
+		return true;
+	}
+	return false;
+}
+
+#ifndef SUSFS_HIDE_MODULES_NO_CTL
+
+static int susfs_hide_rt_add(const char *name)
+{
+	unsigned long flags;
+	int i, ret = 0;
+
+	if (!name || !name[0])
+		return -EINVAL;
+	if (strnlen(name, MODULE_NAME_LEN) >= MODULE_NAME_LEN)
+		return -ENAMETOOLONG;
+
+	/* 已在编译期表里：无需重复登记 */
+	for (i = 0; i < ARRAY_SIZE(susfs_hidden_modules); i++) {
+		if (!strcmp(name, susfs_hidden_modules[i]))
+			return 0;
+	}
+
+	spin_lock_irqsave(&susfs_hidden_lock, flags);
+	for (i = 0; i < susfs_hidden_rt_nr; i++) {
+		if (!strcmp(name, susfs_hidden_rt[i]))
+			goto out_unlock;
+	}
+	if (susfs_hidden_rt_nr >= SUSFS_HIDE_MODULES_RT_MAX) {
+		ret = -ENOSPC;
+		goto out_unlock;
+	}
+	strscpy(susfs_hidden_rt[susfs_hidden_rt_nr++], name, MODULE_NAME_LEN);
+out_unlock:
+	spin_unlock_irqrestore(&susfs_hidden_lock, flags);
+	if (!ret)
+		susfs_hide_sysfs_mark(name, true);	/* 进程上下文，可以 kern_path */
+	return ret;
+}
+
+static int susfs_hide_rt_del(const char *name)
+{
+	unsigned long flags;
+	int i, ret = -ENOENT;
+
+	if (!name || !name[0])
+		return -EINVAL;
+
+	spin_lock_irqsave(&susfs_hidden_lock, flags);
+	for (i = 0; i < susfs_hidden_rt_nr; i++) {
+		if (!strcmp(name, susfs_hidden_rt[i])) {
+			/* 尾部前移，保持数组紧凑 */
+			memmove(&susfs_hidden_rt[i], &susfs_hidden_rt[i + 1],
+				(size_t)(susfs_hidden_rt_nr - i - 1) * MODULE_NAME_LEN);
+			susfs_hidden_rt_nr--;
+			memset(&susfs_hidden_rt[susfs_hidden_rt_nr], 0, MODULE_NAME_LEN);
+			ret = 0;
+			break;
+		}
+	}
+	spin_unlock_irqrestore(&susfs_hidden_lock, flags);
+	if (!ret)
+		susfs_hide_sysfs_mark(name, false);
+	return ret;
+}
+
+static void susfs_hide_rt_clear(void)
+{
+	unsigned long flags;
+
+	spin_lock_irqsave(&susfs_hidden_lock, flags);
+	memset(susfs_hidden_rt, 0, sizeof(susfs_hidden_rt));
+	susfs_hidden_rt_nr = 0;
+	spin_unlock_irqrestore(&susfs_hidden_lock, flags);
+}
+
+/* ------------------------------------------------------------------
+ * 零宽字符路径拦截（CVE-2024-43093 类绕过）
+ *
+ * 背景：/storage/emulated/0/Android/data/<pkg> 的访问控制靠字符串匹配，
+ *       在路径里插入零宽字符可以让匹配失败、却仍解析到真实目录
+ *       → 检测方据此能读到被 HMA 隐藏的 app 的目录，反推包名。
+ *
+ * 做法：在 getname_flags() 里检查路径。
+ *       只有当"可忽略字符出现在 Android/data 之前"才拦，
+ *       这样 Android/data/xxx/files/👨‍👩‍👧.png 这类合法文件名不受影响。
+ * ------------------------------------------------------------------ */
+
+/*
+ * 判定规则（不依赖具体字符表）：
+ *   把路径里的非 ASCII 字符全部丢掉，得到 norm；
+ *   如果 norm 里出现 "Android/data"，且有非 ASCII 字符落在它之前
+ *   → 判定为绕过，返回 true。
+ *
+ * 这样任何 Unicode 手段（零宽、可忽略码点、变体选择符、bidi 控制符…）
+ * 都覆盖得到，不需要维护字符表。合法的 Android/data 路径是纯 ASCII，
+ * 而文件名里的 emoji 在 "Android/data" 之后，不受影响。
+ */
+#define SUSFS_ZWC_NORM_MAX	256
+
+/*
+ * 第一道：全局拒绝"可忽略码点"
+ *
+ * 这些字符在路径里没有任何正当用途，而 FUSE/MediaProvider 在解析时会忽略它们，
+ * 于是 "Android/data/x" 可以被写成 "Android/data/x"（中间插字符）绕过黑名单。
+ *
+ * 故意不包含：
+ *   U+200D ZWJ   —— emoji 组合（👨‍👩‍👧）会用到
+ *   U+FE0F VS16  —— emoji 变体选择符（💯）会用到
+ */
+struct susfs_zwc_seq {
+	u8 b0, b1, b2;
+	u8 len;
+};
+
+static const struct susfs_zwc_seq susfs_zwc_seqs[] = {
+	{0xC2, 0xAD, 0x00, 2},	/* U+00AD SOFT HYPHEN */
+	{0xCD, 0x8F, 0x00, 2},	/* U+034F COMBINING GRAPHEME JOINER */
+	{0xE1, 0xA0, 0x8B, 3},	/* U+180B */
+	{0xE1, 0xA0, 0x8C, 3},	/* U+180C */
+	{0xE1, 0xA0, 0x8D, 3},	/* U+180D */
+	{0xE1, 0xA0, 0x8E, 3},	/* U+180E MONGOLIAN VOWEL SEPARATOR */
+	{0xE2, 0x80, 0x8B, 3},	/* U+200B ZERO WIDTH SPACE */
+	{0xE2, 0x80, 0x8C, 3},	/* U+200C ZWNJ */
+	{0xE2, 0x80, 0x8E, 3},	/* U+200E LRM */
+	{0xE2, 0x80, 0x8F, 3},	/* U+200F RLM */
+	{0xE2, 0x80, 0xAA, 3},	/* U+202A LRE */
+	{0xE2, 0x80, 0xAB, 3},	/* U+202B RLE */
+	{0xE2, 0x80, 0xAC, 3},	/* U+202C PDF */
+	{0xE2, 0x80, 0xAD, 3},	/* U+202D LRO */
+	{0xE2, 0x80, 0xAE, 3},	/* U+202E RLO */
+	{0xE2, 0x81, 0xA0, 3},	/* U+2060 WORD JOINER */
+	{0xE2, 0x81, 0xA1, 3},	/* U+2061 */
+	{0xE2, 0x81, 0xA2, 3},	/* U+2062 */
+	{0xE2, 0x81, 0xA3, 3},	/* U+2063 */
+	{0xE2, 0x81, 0xA4, 3},	/* U+2064 */
+	{0xE3, 0x85, 0xA4, 3},	/* U+3164 HANGUL FILLER */
+	{0xEF, 0xBB, 0xBF, 3},	/* U+FEFF BOM / ZWNBSP */
+};
+
+/* 命中返回该序列长度，否则 0 */
+static int susfs_zwc_match(const char *name, int left)
+{
+	int k;
+
+	for (k = 0; k < ARRAY_SIZE(susfs_zwc_seqs); k++) {
+		const struct susfs_zwc_seq *q = &susfs_zwc_seqs[k];
+
+		if (q->len > left)
+			continue;
+		if ((u8)name[0] != q->b0 || (u8)name[1] != q->b1)
+			continue;
+		if (q->len == 3 && (u8)name[2] != q->b2)
+			continue;
+		return q->len;
+	}
+	return 0;
+}
+
+bool susfs_is_zwc_bypass_path(const char *name, int len)
+{
+	char norm[SUSFS_ZWC_NORM_MAX];
+	int i, n = 0, first_skip = -1;
+	bool non_ascii = false;
+	const char *hit;
+
+	if (!name || len <= 0)
+		return false;
+
+	/* 全 ASCII → 不可能命中（绝大多数路径走这条） */
+	for (i = 0; i < len; i++) {
+		if ((unsigned char)name[i] >= 0x80) {
+			non_ascii = true;
+			break;
+		}
+	}
+	if (!non_ascii)
+		return false;
+
+	/*
+	 * 第一道：任何位置出现可忽略码点 → 直接拒绝。
+	 * 这是 KPM（No 0）的做法，也是绕过 Android/data 黑名单的必要条件。
+	 */
+	for (i = 0; i < len; ) {
+		int step = susfs_zwc_match(name + i, len - i);
+
+		if (step) {
+			pr_debug_ratelimited("susfs: zwc path rejected\n");
+			return true;
+		}
+		if ((unsigned char)name[i] < 0x80)
+			i++;
+		else
+			i += 2;		/* 多字节字符，粗略跳过即可（只为省时间） */
+	}
+
+	/*
+	 * 第二道：其它非 ASCII（中文目录名等）出现在
+	 * "Android/data" + 包名段 之内也拒绝。
+	 */
+	for (i = 0; i < len; i++) {
+		if ((unsigned char)name[i] < 0x80) {
+			if (n >= SUSFS_ZWC_NORM_MAX - 1)
+				return false;
+			norm[n++] = name[i];
+		} else if (first_skip < 0) {
+			first_skip = n;
+		}
+	}
+	norm[n] = '\0';
+
+	if (first_skip < 0)
+		return false;
+
+	hit = strstr(norm, "Android/data");
+	if (!hit)
+		return false;
+
+	n = (int)(hit - norm) + 12;
+	if (norm[n] == '/')
+		n++;
+	while (norm[n] && norm[n] != '/')
+		n++;
+
+	return first_skip <= n;
+}
+
+/*
+ * procfs 节点隐藏：非 root 直接当它不存在。
+ * procfs 的可见性由 proc_dir_entry 链表决定（readdir / lookup），
+ * 与 inode flags 无关，所以必须在遍历处过滤。
+ */
+bool susfs_proc_name_hidden(const char *name, unsigned int len)
+{
+	static const char ctl_name[] = "oplus_mem_zone";
+
+	if (!name || len != sizeof(ctl_name) - 1)
+		return false;
+	if (memcmp(name, ctl_name, sizeof(ctl_name) - 1))
+		return false;
+
+	return current_uid().val != 0;
+}
+
+static int susfs_hide_show(struct seq_file *m, void *v)
+{
+	unsigned long flags;
+	int i;
+
+	seq_puts(m, "compiled:");
+	for (i = 0; i < ARRAY_SIZE(susfs_hidden_modules); i++)
+		seq_printf(m, " %s", susfs_hidden_modules[i]);
+	seq_puts(m, "\n");
+
+	spin_lock_irqsave(&susfs_hidden_lock, flags);
+	seq_printf(m, "runtime (%d/%d):", susfs_hidden_rt_nr,
+		   SUSFS_HIDE_MODULES_RT_MAX);
+	for (i = 0; i < susfs_hidden_rt_nr; i++)
+		seq_printf(m, " %s", susfs_hidden_rt[i]);
+	spin_unlock_irqrestore(&susfs_hidden_lock, flags);
+	seq_puts(m, "\n");
+
+	seq_puts(m, "filter: 由上游 SUSFS 2.4.0 管理（papp/sallow 按包名下发）\n");
+	seq_printf(m, "skipped: modules_lines=%d kallsyms_lines=%d symbolname=%d sysfs_marked=%d\n",
+		   atomic_read(&susfs_n_mod_skipped),
+		   atomic_read(&susfs_n_sym_skipped),
+		   atomic_read(&susfs_n_symname_skipped),
+		   atomic_read(&susfs_n_sysfs_marked));
+
+	return 0;
+}
+
+static int susfs_hide_open(struct inode *inode, struct file *file)
+{
+	/*
+	 * 非 root 一律当成"文件不存在"：-ENOENT 与路径真不存在无法区分，
+	 * 不会像 -EPERM/-EACCES 那样暴露"这里有个受保护的东西"。
+	 */
+	if (current_uid().val != 0)
+		return -ENOENT;
+	if (!capable(CAP_SYS_ADMIN))
+		return -ENOENT;
+	return single_open(file, susfs_hide_show, NULL);
+}
+
+static ssize_t susfs_hide_write_locked(struct file *file, const char __user *ubuf,
+				       size_t count, loff_t *ppos)
+{
+	/* 1024 够放 ~160 个 uid（puid 命令一次性下发整份名单） */
+	char cmd[1024], *op, *arg;
+	int ret;
+
+	if (!capable(CAP_SYS_ADMIN))
+		return -EPERM;
+	if (count == 0)
+		return 0;
+	if (count >= sizeof(cmd))
+		return -EINVAL;
+	if (copy_from_user(cmd, ubuf, count))
+		return -EFAULT;
+	cmd[count] = '\0';
+	strim(cmd);
+
+	if (!cmd[0])
+		return 0;
+
+	op = cmd;
+	arg = strchr(cmd, ' ');
+	if (arg) {
+		*arg++ = '\0';
+		arg = skip_spaces(arg);
+	}
+
+	if (!strcmp(op, "clear") && !arg) {
+		susfs_hide_rt_clear();
+		return count;
+	}
+	if (!strcmp(op, "add")) {
+		ret = susfs_hide_rt_add(arg);
+		return ret ? ret : count;
+	}
+	if (!strcmp(op, "del")) {
+		ret = susfs_hide_rt_del(arg);
+		return ret ? ret : count;
+	}
+
+	/*
+	 * papp / sallow：把包名交给上游 SUSFS 2.4.0 的过滤实现
+	 * （上游按包名解析 uid，自己维护位图与重新解析线程）
+	 */
+	if (!strcmp(op, "papp") || !strcmp(op, "sallow")) {
+		/* 上游解析器按逗号切分包名，这里把空格统一转成逗号 */
+		char *q = arg;
+
+		if (!q)
+			return -EINVAL;
+		while (*q) {
+			if (*q == ' ')
+				*q = ',';
+			q++;
+		}
+		if (!strcmp(op, "papp"))
+			ret = susfs_kernel_set_priority_apps(arg);
+		else
+			ret = susfs_kernel_set_sus_path_apps(arg);
+		return ret ? ret : count;
+	}
+	if (!strcmp(op, "puid")) {
+		/* 2.4.0 起上游只接受包名；直接下发 uid 已不再支持 */
+		return -EINVAL;
+	}
+
+	/* 裸名字等同 add，方便脚本一次写一行 */
+	return susfs_hide_rt_add(op) ? -EINVAL : count;
+}
+
+/*
+ * 写完之后把 dentry 从 dcache 踢掉：
+ * 平时这个路径被缓存着，非 root 的 stat 会直接命中缓存，
+ * 从而绕过 proc_lookup_de() 的过滤、最终被 SELinux 判成 EACCES。
+ * 失效后下一次查找必须走 proc 链表 → 我们的过滤返回 ENOENT。
+ */
+static ssize_t susfs_hide_write(struct file *file, const char __user *ubuf,
+				size_t count, loff_t *ppos)
+{
+	ssize_t ret = susfs_hide_write_locked(file, ubuf, count, ppos);
+
+	if (ret > 0 && file) {
+		d_invalidate(file->f_path.dentry);
+		susfs_ctl_dentry_rounds = 0;
+		schedule_delayed_work(&susfs_ctl_dentry_dw, HZ / 2);
+	}
+
+	return ret;
+}
+
+/*
+ * 关闭时立刻让 dentry 失效：开机脚本是 open→write→close，
+ * close 时文件已不被占用，d_invalidate 几乎必定成功 → 窗口期接近 0。
+ */
+static int susfs_hide_release(struct inode *inode, struct file *file)
+{
+	d_invalidate(file->f_path.dentry);
+	return single_release(inode, file);
+}
+
+static const struct proc_ops susfs_hide_proc_ops = {
+	.proc_open	= susfs_hide_open,
+	.proc_read	= seq_read,
+	.proc_lseek	= seq_lseek,
+	.proc_release	= susfs_hide_release,
+	.proc_write	= susfs_hide_write,
+};
+
+static int __init oplus_mem_zone_init(void)
+{
+	if (!proc_create("oplus_mem_zone", 0600, NULL, &susfs_hide_proc_ops))
+		pr_warn("oplus_mem_zone: /proc node not created\n");
+	/* 开机后模块才 insmod，这里补几轮 /sys/module 规则 */
+	schedule_delayed_work(&susfs_hide_sysfs_dw, 10 * HZ);
+	return 0;
+}
+/* late_initcall：确保 procfs 的 root 已就绪再建节点 */
+late_initcall(oplus_mem_zone_init);
+
+#endif /* SUSFS_HIDE_MODULES_NO_CTL */
