From: workspace <workspace@localhost>
Subject: [PATCH] susfs: hide selected kernel modules from /proc/modules and /proc/kallsyms

内建版 hide_modules，等价于 susfs4ksu-for-lkm 的可加载模块实现：
  - kernel/module/procfs.c  m_show()  按 module->name 跳过整行（所有读者，含 root）
  - kernel/kallsyms.c       s_show()  按 module_name 跳过整行（模块符号一并消失）
  - /sys/module/<name> 由用户态 ksu_susfs add_sus_path 负责（非 root ENOENT，root 可见）

前置：susfs 主补丁 50_add_susfs_in_gki-*.patch 已应用（本补丁排在其后）。
diff --git a/fs/susfs_hide_modules.c b/fs/susfs_hide_modules.c
new file mode 100644
index 000000000..0000000
--- /dev/null
+++ b/fs/susfs_hide_modules.c
@@ -0,0 +1,374 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * susfs_hide_modules.c - 按名字把指定内核模块从 /proc/modules 与 /proc/kallsyms 里抹掉
+ *
+ * 与 susfs4ksu-for-lkm 的 hide_modules 等价，但走源码：没有 .ko、没有运行时 hook、
+ * 没有模块条目需要自己擦。
+ *
+ *   1) /proc/modules  : kernel/module/procfs.c 的 m_show() 开头 return 0
+ *                        -> 所有读者（含 root）都看不到这一行
+ *   2) /proc/kallsyms : kernel/kallsyms.c 的 s_show() 开头按 module_name 过滤
+ *                        -> 该模块的 __kstrtab_* / *_init 等符号一并消失
+ *   3) /sys/module/<name> : 不在这里做。用户态用
+ *                        ksu_susfs add_sus_path /sys/module/<name>
+ *                        效果为「非 root 得到 ENOENT，root 仍可读」
+ *
+ * 名单有两个来源，取并集：
+ *   - 编译期常量 susfs_hidden_modules[]：开机即生效，无需用户态配合
+ *   - 运行时表：写 /proc/susfs_hide_modules（0600，仅 root）
+ *       echo "add zygisk_loader" > /proc/susfs_hide_modules
+ *       echo "del zygisk_loader" > /proc/susfs_hide_modules
+ *       echo clear               > /proc/susfs_hide_modules   # 只清运行时表
+ *       cat /proc/susfs_hide_modules                          # 看两边的现状
+ *     不定义 SUSFS_HIDE_MODULES_NO_CTL 时才编译这个节点。
+ */
+
+#include <linux/kernel.h>
+#include <linux/init.h>
+#include <linux/module.h>	/* MODULE_NAME_LEN */
+#include <linux/string.h>
+#include <linux/spinlock.h>
+#include <linux/atomic.h>
+#include <linux/fs.h>		/* set_bit + inode->i_mapping */
+#include <linux/namei.h>	/* kern_path */
+#include <linux/workqueue.h>	/* 延迟同步 /sys/module 规则 */
+#include <linux/susfs_def.h>	/* AS_FLAGS_SUS_PATH */
+#include <linux/proc_fs.h>
+#include <linux/seq_file.h>
+#include <linux/uaccess.h>
+#include <linux/capability.h>
+#include <linux/susfs_hide_modules.h>
+
+/*
+ * 编译期名单。名字必须精确匹配 struct module->name，也就是
+ *   lsmod 第一列 / cat /proc/modules 第一列（不带 .ko，'-' 已转成 '_'）
+ */
+static const char *const susfs_hidden_modules[] = {
+	"qpace_drv",
+	"qpace_zram",
+};
+
+#ifndef SUSFS_HIDE_MODULES_RT_MAX
+#define SUSFS_HIDE_MODULES_RT_MAX 32
+#endif
+
+static char susfs_hidden_rt[SUSFS_HIDE_MODULES_RT_MAX][MODULE_NAME_LEN];
+static int susfs_hidden_rt_nr;
+static DEFINE_SPINLOCK(susfs_hidden_lock);
+
+/* 命中统计：/proc/susfs_hide_modules 里可读，用来确认过滤真的在生效 */
+static atomic_t susfs_n_mod_skipped = ATOMIC_INIT(0);
+static atomic_t susfs_n_sym_skipped = ATOMIC_INIT(0);
+static atomic_t susfs_n_symname_skipped = ATOMIC_INIT(0);
+static atomic_t susfs_n_sysfs_marked = ATOMIC_INIT(0);
+
+/* 中断/seq_file 上下文都可能调用：不分配、不睡眠 */
+/*
+ * /sys/module/<name> 的隐藏：跟 SUSFS 的 sus_path 用同一个位。
+ * 内置 SUSFS 只对外提供 susfs_add_sus_path(void __user **)（要用户态指针），
+ * 内核态拿不到；但隐藏动作本身只是置位，直接做即可。
+ */
+static void susfs_hide_sysfs_mark(const char *name, bool hide)
+{
+	char path[64];
+	struct inode *inode;
+	struct path p;
+
+	if (!name || !name[0])
+		return;
+	snprintf(path, sizeof(path), "/sys/module/%s", name);
+	if (kern_path(path, LOOKUP_FOLLOW, &p))
+		return;		/* 模块还没加载，下次再试 */
+	inode = d_backing_inode(p.dentry);
+	if (inode && inode->i_mapping) {
+		if (hide) {
+			set_bit(AS_FLAGS_SUS_PATH, &inode->i_mapping->flags);
+			atomic_inc(&susfs_n_sysfs_marked);
+		} else {
+			clear_bit(AS_FLAGS_SUS_PATH, &inode->i_mapping->flags);
+		}
+	}
+	path_put(&p);
+}
+
+/* 把名单里所有名字的 /sys/module 目录同步一遍 */
+static void susfs_hide_sysfs_sync(void)
+{
+	unsigned long flags;
+	char rt[SUSFS_HIDE_MODULES_RT_MAX][MODULE_NAME_LEN];
+	int nr, i;
+
+	for (i = 0; i < ARRAY_SIZE(susfs_hidden_modules); i++)
+		susfs_hide_sysfs_mark(susfs_hidden_modules[i], true);
+
+	spin_lock_irqsave(&susfs_hidden_lock, flags);
+	nr = susfs_hidden_rt_nr;
+	if (nr > SUSFS_HIDE_MODULES_RT_MAX)
+		nr = SUSFS_HIDE_MODULES_RT_MAX;
+	memcpy(rt, susfs_hidden_rt, sizeof(rt[0]) * nr);
+	spin_unlock_irqrestore(&susfs_hidden_lock, flags);
+
+	for (i = 0; i < nr; i++)
+		susfs_hide_sysfs_mark(rt[i], true);
+}
+
+/* 模块可能在开机后才 insmod：补几轮 */
+static void susfs_hide_sysfs_work(struct work_struct *w);
+static DECLARE_DELAYED_WORK(susfs_hide_sysfs_dw, susfs_hide_sysfs_work);
+static int susfs_hide_sysfs_rounds;
+
+static void susfs_hide_sysfs_work(struct work_struct *w)
+{
+	susfs_hide_sysfs_sync();
+	if (++susfs_hide_sysfs_rounds < 4)
+		schedule_delayed_work(&susfs_hide_sysfs_dw, 15 * HZ);
+}
+
+static bool susfs_hide_match(const char *name)
+{
+	unsigned long flags;
+	bool hit = false;
+	int i;
+
+	if (!name || !name[0])
+		return false;
+
+	for (i = 0; i < ARRAY_SIZE(susfs_hidden_modules); i++) {
+		if (!strcmp(name, susfs_hidden_modules[i]))
+			return true;
+	}
+
+	spin_lock_irqsave(&susfs_hidden_lock, flags);
+	for (i = 0; i < susfs_hidden_rt_nr; i++) {
+		if (!strcmp(name, susfs_hidden_rt[i])) {
+			hit = true;
+			break;
+		}
+	}
+	spin_unlock_irqrestore(&susfs_hidden_lock, flags);
+
+	return hit;
+}
+
+/* /proc/modules 的 m_show() 调用：命中就计一条 */
+bool susfs_hide_module_name(const char *name)
+{
+	if (susfs_hide_match(name)) {
+		atomic_inc(&susfs_n_mod_skipped);
+		return true;
+	}
+	return false;
+}
+
+/*
+ * 符号名过滤：处理"符号定义在别的模块里"的情况。
+ * 例：qpace_drv 的压缩函数被厂商 zram.ko 包了一层，
+ *     符号归属变成 [zram]，按模块名抓不到，只能按符号名抹。
+ * 只认 qpace 这一个前缀串，避免误伤无关符号。
+ */
+static const char *const susfs_hidden_sym_parts[] = {
+	"qpace",
+};
+
+static bool susfs_hide_sym_name_match(const char *name)
+{
+	int i;
+
+	if (!name || !name[0])
+		return false;
+
+	for (i = 0; i < ARRAY_SIZE(susfs_hidden_sym_parts); i++) {
+		if (strstr(name, susfs_hidden_sym_parts[i]))
+			return true;
+	}
+	return false;
+}
+
+bool susfs_hide_symbol_name(const char *name)
+{
+	if (susfs_hide_sym_name_match(name)) {
+		atomic_inc(&susfs_n_symname_skipped);
+		return true;
+	}
+	return false;
+}
+
+/* /proc/kallsyms 的 s_show() 调用：只对模块符号计一条 */
+bool susfs_hide_module_symbol(const char *module_name)
+{
+	if (susfs_hide_match(module_name)) {
+		atomic_inc(&susfs_n_sym_skipped);
+		return true;
+	}
+	return false;
+}
+
+#ifndef SUSFS_HIDE_MODULES_NO_CTL
+
+static int susfs_hide_rt_add(const char *name)
+{
+	unsigned long flags;
+	int i, ret = 0;
+
+	if (!name || !name[0])
+		return -EINVAL;
+	if (strnlen(name, MODULE_NAME_LEN) >= MODULE_NAME_LEN)
+		return -ENAMETOOLONG;
+
+	/* 已在编译期表里：无需重复登记 */
+	for (i = 0; i < ARRAY_SIZE(susfs_hidden_modules); i++) {
+		if (!strcmp(name, susfs_hidden_modules[i]))
+			return 0;
+	}
+
+	spin_lock_irqsave(&susfs_hidden_lock, flags);
+	for (i = 0; i < susfs_hidden_rt_nr; i++) {
+		if (!strcmp(name, susfs_hidden_rt[i]))
+			goto out_unlock;
+	}
+	if (susfs_hidden_rt_nr >= SUSFS_HIDE_MODULES_RT_MAX) {
+		ret = -ENOSPC;
+		goto out_unlock;
+	}
+	strscpy(susfs_hidden_rt[susfs_hidden_rt_nr++], name, MODULE_NAME_LEN);
+out_unlock:
+	spin_unlock_irqrestore(&susfs_hidden_lock, flags);
+	if (!ret)
+		susfs_hide_sysfs_mark(name, true);	/* 进程上下文，可以 kern_path */
+	return ret;
+}
+
+static int susfs_hide_rt_del(const char *name)
+{
+	unsigned long flags;
+	int i, ret = -ENOENT;
+
+	if (!name || !name[0])
+		return -EINVAL;
+
+	spin_lock_irqsave(&susfs_hidden_lock, flags);
+	for (i = 0; i < susfs_hidden_rt_nr; i++) {
+		if (!strcmp(name, susfs_hidden_rt[i])) {
+			/* 尾部前移，保持数组紧凑 */
+			memmove(&susfs_hidden_rt[i], &susfs_hidden_rt[i + 1],
+				(size_t)(susfs_hidden_rt_nr - i - 1) * MODULE_NAME_LEN);
+			susfs_hidden_rt_nr--;
+			memset(&susfs_hidden_rt[susfs_hidden_rt_nr], 0, MODULE_NAME_LEN);
+			ret = 0;
+			break;
+		}
+	}
+	spin_unlock_irqrestore(&susfs_hidden_lock, flags);
+	if (!ret)
+		susfs_hide_sysfs_mark(name, false);
+	return ret;
+}
+
+static void susfs_hide_rt_clear(void)
+{
+	unsigned long flags;
+
+	spin_lock_irqsave(&susfs_hidden_lock, flags);
+	memset(susfs_hidden_rt, 0, sizeof(susfs_hidden_rt));
+	susfs_hidden_rt_nr = 0;
+	spin_unlock_irqrestore(&susfs_hidden_lock, flags);
+}
+
+static int susfs_hide_show(struct seq_file *m, void *v)
+{
+	unsigned long flags;
+	int i;
+
+	seq_puts(m, "compiled:");
+	for (i = 0; i < ARRAY_SIZE(susfs_hidden_modules); i++)
+		seq_printf(m, " %s", susfs_hidden_modules[i]);
+	seq_puts(m, "\n");
+
+	spin_lock_irqsave(&susfs_hidden_lock, flags);
+	seq_printf(m, "runtime (%d/%d):", susfs_hidden_rt_nr,
+		   SUSFS_HIDE_MODULES_RT_MAX);
+	for (i = 0; i < susfs_hidden_rt_nr; i++)
+		seq_printf(m, " %s", susfs_hidden_rt[i]);
+	spin_unlock_irqrestore(&susfs_hidden_lock, flags);
+	seq_puts(m, "\n");
+
+	seq_printf(m, "skipped: modules_lines=%d kallsyms_lines=%d symbolname=%d sysfs_marked=%d\n",
+		   atomic_read(&susfs_n_mod_skipped),
+		   atomic_read(&susfs_n_sym_skipped),
+		   atomic_read(&susfs_n_symname_skipped),
+		   atomic_read(&susfs_n_sysfs_marked));
+
+	return 0;
+}
+
+static int susfs_hide_open(struct inode *inode, struct file *file)
+{
+	if (!capable(CAP_SYS_ADMIN))
+		return -EPERM;
+	return single_open(file, susfs_hide_show, NULL);
+}
+
+static ssize_t susfs_hide_write(struct file *file, const char __user *ubuf,
+				size_t count, loff_t *ppos)
+{
+	char cmd[128], *op, *arg;
+	int ret;
+
+	if (!capable(CAP_SYS_ADMIN))
+		return -EPERM;
+	if (count == 0)
+		return 0;
+	if (count >= sizeof(cmd))
+		return -EINVAL;
+	if (copy_from_user(cmd, ubuf, count))
+		return -EFAULT;
+	cmd[count] = '\0';
+	strim(cmd);
+
+	if (!cmd[0])
+		return 0;
+
+	op = cmd;
+	arg = strchr(cmd, ' ');
+	if (arg) {
+		*arg++ = '\0';
+		arg = skip_spaces(arg);
+	}
+
+	if (!strcmp(op, "clear") && !arg) {
+		susfs_hide_rt_clear();
+		return count;
+	}
+	if (!strcmp(op, "add")) {
+		ret = susfs_hide_rt_add(arg);
+		return ret ? ret : count;
+	}
+	if (!strcmp(op, "del")) {
+		ret = susfs_hide_rt_del(arg);
+		return ret ? ret : count;
+	}
+
+	/* 裸名字等同 add，方便脚本一次写一行 */
+	return susfs_hide_rt_add(op) ? -EINVAL : count;
+}
+
+static const struct proc_ops susfs_hide_proc_ops = {
+	.proc_open	= susfs_hide_open,
+	.proc_read	= seq_read,
+	.proc_lseek	= seq_lseek,
+	.proc_release	= single_release,
+	.proc_write	= susfs_hide_write,
+};
+
+static int __init susfs_hide_modules_init(void)
+{
+	if (!proc_create("susfs_hide_modules", 0600, NULL, &susfs_hide_proc_ops))
+		pr_warn("susfs_hide_modules: /proc node not created\n");
+	/* 开机后模块才 insmod，这里补几轮 /sys/module 规则 */
+	schedule_delayed_work(&susfs_hide_sysfs_dw, 10 * HZ);
+	return 0;
+}
+/* late_initcall：确保 procfs 的 root 已就绪再建节点 */
+late_initcall(susfs_hide_modules_init);
+
+#endif /* SUSFS_HIDE_MODULES_NO_CTL */
diff --git a/include/linux/susfs_hide_modules.h b/include/linux/susfs_hide_modules.h
new file mode 100644
index 000000000..0000000
--- /dev/null
+++ b/include/linux/susfs_hide_modules.h
@@ -0,0 +1,28 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+#ifndef _LINUX_SUSFS_HIDE_MODULES_H
+#define _LINUX_SUSFS_HIDE_MODULES_H
+
+#include <linux/types.h>
+
+#ifdef CONFIG_KSU_SUSFS
+bool susfs_hide_module_name(const char *name);
+bool susfs_hide_module_symbol(const char *module_name);
+bool susfs_hide_symbol_name(const char *name);
+#else
+static inline bool susfs_hide_module_name(const char *name)
+{
+	return false;
+}
+
+static inline bool susfs_hide_module_symbol(const char *module_name)
+{
+	return false;
+}
+
+static inline bool susfs_hide_symbol_name(const char *name)
+{
+	return false;
+}
+#endif
+
+#endif /* _LINUX_SUSFS_HIDE_MODULES_H */
diff --git a/fs/Makefile b/fs/Makefile
--- a/fs/Makefile
+++ b/fs/Makefile
@@ -24,4 +24,5 @@
 obj-$(CONFIG_BUFFER_HEAD)	+= buffer.o mpage.o
 obj-$(CONFIG_PROC_FS)		+= proc_namespace.o
+obj-$(CONFIG_KSU_SUSFS) += susfs_hide_modules.o
 obj-$(CONFIG_LEGACY_DIRECT_IO)	+= direct-io.o
 obj-y				+= notify/
diff --git a/kernel/module/procfs.c b/kernel/module/procfs.c
--- a/kernel/module/procfs.c
+++ b/kernel/module/procfs.c
@@ -9,3 +9,6 @@
 #include <linux/module.h>
+#ifdef CONFIG_KSU_SUSFS
+#include <linux/susfs_hide_modules.h>
+#endif
 #include <linux/kallsyms.h>
 #include <linux/mutex.h>
@@ -74,10 +77,16 @@ static int m_show(struct seq_file *m, void *p)
 static int m_show(struct seq_file *m, void *p)
 {
 	struct module *mod = list_entry(p, struct module, list);
 	char buf[MODULE_FLAGS_BUF_SIZE];
 	void *value;
 	unsigned int size;
 
+#ifdef CONFIG_KSU_SUSFS
+	/* 名单内的模块整行不输出：任何人（含 root）读 /proc/modules 都看不到 */
+	if (susfs_hide_module_name(mod->name))
+		return 0;
+#endif
+
 	/* We always ignore unformed modules. */
 	if (mod->state == MODULE_STATE_UNFORMED)
 		return 0;
diff --git a/kernel/kallsyms.c b/kernel/kallsyms.c
--- a/kernel/kallsyms.c
+++ b/kernel/kallsyms.c
@@ -14,3 +14,6 @@
  */
+#ifdef CONFIG_KSU_SUSFS
+#include <linux/susfs_hide_modules.h>
+#endif
 #include <linux/kallsyms.h>
 #include <linux/init.h>
@@ -728,10 +731,24 @@ static int s_show(struct seq_file *m, void *p)
 static int s_show(struct seq_file *m, void *p)
 {
 	void *value;
 	struct kallsym_iter *iter = m->private;
 
 	/* Some debugging symbols have no name.  Ignore them. */
 	if (!iter->name[0])
 		return 0;
 
+#ifdef CONFIG_KSU_SUSFS
+	/*
+	 * 模块符号按 module_name 过滤：被藏模块的 __kstrtab_* / *_init / *_exit
+	 * 一并消失，避免检测方从 /proc/kallsyms 反推模块存在。
+	 */
+	if (iter->module_name[0] &&
+	    susfs_hide_module_symbol(iter->module_name))
+		return 0;
+	/* 符号定义在别的模块里（如厂商 zram 包了 qpace 的压族函数）
+	 * 时按模块名抓不到，这里按符号名再抹一次 */
+	if (susfs_hide_symbol_name(iter->name))
+		return 0;
+#endif
+
 	value = iter->show_value ? (void *)iter->value : NULL;
