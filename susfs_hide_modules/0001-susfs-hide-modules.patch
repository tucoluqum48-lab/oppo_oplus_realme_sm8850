From: workspace <workspace@localhost>
Subject: [PATCH] susfs: hide selected kernel modules from /proc/modules and /proc/kallsyms

内建版 hide_modules，等价于 susfs4ksu-for-lkm 的可加载模块实现：
  - kernel/module/procfs.c  m_show()  按 module->name 跳过整行（所有读者，含 root）
  - kernel/kallsyms.c       s_show()  按 module_name 跳过整行（模块符号一并消失）
  - /sys/module/<name> 由本模块置 strict 位，对所有非 root 生效（root 仍可见）

前置：susfs 主补丁 50_add_susfs_in_gki-*.patch 已应用（本补丁排在其后）。
diff --git a/fs/susfs_hide_modules.c b/fs/susfs_hide_modules.c
new file mode 100644
index 000000000..0000000
--- /dev/null
+++ b/fs/susfs_hide_modules.c
@@ -0,0 +1,750 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * susfs_hide_modules.c - 按名字把指定内核模块从 /proc/modules 与 /proc/kallsyms 里抹掉
+ *
+ * 与 susfs4ksu-for-lkm 的 hide_modules 等价，但走源码：没有 .ko、没有运行时 hook、
+ * 没有模块条目需要自己擦。
+ *
+ *   1) /proc/modules  : kernel/module/procfs.c 的 m_show() 开头 return 0
+ *                        -> 所有读者（含 root）都看不到这一行
+ *   2) /proc/kallsyms : kernel/kallsyms.c 的 s_show() 开头按 module_name 过滤
+ *                        -> 该模块的 __kstrtab_* / *_init 等符号一并消失
+ *   3) /sys/module/<name> : 不在这里做。用户态用
+ *                        ksu_susfs add_sus_path /sys/module/<name>
+ *                        效果为「非 root 得到 ENOENT，root 仍可读」
+ *
+ * 名单有两个来源，取并集：
+ *   - 编译期常量 susfs_hidden_modules[]：开机即生效，无需用户态配合
+ *   - 运行时表：写 /proc/oplus_mem_zone（0600，仅 root）
+ *       echo "add zygisk_loader" > /proc/oplus_mem_zone
+ *       echo "del zygisk_loader" > /proc/oplus_mem_zone
+ *       echo clear               > /proc/oplus_mem_zone   # 只清运行时表
+ *       cat /proc/oplus_mem_zone                          # 看两边的现状
+ *     不定义 SUSFS_HIDE_MODULES_NO_CTL 时才编译这个节点。
+ */
+
+#include <linux/kernel.h>
+#include <linux/init.h>
+#include <linux/module.h>	/* MODULE_NAME_LEN */
+#include <linux/string.h>
+#include <linux/spinlock.h>
+#include <linux/atomic.h>
+#include <linux/fs.h>		/* set_bit + inode->i_mapping */
+#include <linux/namei.h>	/* kern_path */
+#include <linux/workqueue.h>	/* 延迟同步 /sys/module 规则 */
+#include <linux/susfs_hide_modules.h>
+#include <linux/proc_fs.h>
+#include <linux/seq_file.h>
+#include <linux/uaccess.h>
+#include <linux/capability.h>
+#include <linux/notifier.h>	/* register_module_notifier */
+#include <linux/dcache.h>	/* DT_* */
+#include <linux/slab.h>
+#include <linux/susfs_hide_modules.h>
+
+/*
+ * 编译期名单。名字必须精确匹配 struct module->name，也就是
+ *   lsmod 第一列 / cat /proc/modules 第一列（不带 .ko，'-' 已转成 '_'）
+ */
+/*
+ * 通用版：编译期名单留空，靠用户态脚本运行时登记（/data/adb/service.d/96-hide-ko.sh
+ * 扫描 /data/adb/modules 下的 .ko）。占位项永远不会匹配真实模块名（模块名不允许带点），
+ * 只为避免零长数组这种编译器扩展。
+ *
+ * 想固定几个模块、开机瞬间就生效的话，在这里加名字即可，例如：
+ *	"qpace_drv",
+ *	"qpace_zram",
+ */
+static const char *const susfs_hidden_modules[] = {
+	"none.invalid",
+};
+
+#ifndef SUSFS_HIDE_MODULES_RT_MAX
+#define SUSFS_HIDE_MODULES_RT_MAX 32
+#endif
+
+static char susfs_hidden_rt[SUSFS_HIDE_MODULES_RT_MAX][MODULE_NAME_LEN];
+static int susfs_hidden_rt_nr;
+static DEFINE_SPINLOCK(susfs_hidden_lock);
+
+/* 命中统计：/proc/oplus_mem_zone 里可读，用来确认过滤真的在生效 */
+static atomic_t susfs_n_mod_skipped = ATOMIC_INIT(0);
+static atomic_t susfs_n_sym_skipped = ATOMIC_INIT(0);
+static atomic_t susfs_n_symname_skipped = ATOMIC_INIT(0);
+static atomic_t susfs_n_sysfs_marked = ATOMIC_INIT(0);
+static atomic_t ko_n_probe_hits = ATOMIC_INIT(0);
+static atomic_t ko_n_probe_miss = ATOMIC_INIT(0);
+static atomic_t ko_n_notify = ATOMIC_INIT(0);
+
+/* 中断/seq_file 上下文都可能调用：不分配、不睡眠 */
+/*
+ * /sys/module/<name> 的隐藏：跟 SUSFS 的 sus_path 用同一个位。
+ * 内置 SUSFS 只对外提供 susfs_add_sus_path(void __user **)（要用户态指针），
+ * 内核态拿不到；但隐藏动作本身只是置位，直接做即可。
+ */
+static void susfs_hide_mark_path(const char *path, bool hide)
+{
+	struct inode *inode;
+	struct path p;
+
+	if (!path || !path[0])
+		return;
+	if (kern_path(path, LOOKUP_FOLLOW, &p))
+		return;		/* 模块还没加载，下次再试 */
+	inode = d_backing_inode(p.dentry);
+	if (inode && inode->i_mapping) {
+		if (hide) {
+			set_bit(AS_FLAGS_SUS_PATH_STRICT, &inode->i_mapping->flags);
+			atomic_inc(&susfs_n_sysfs_marked);
+		} else {
+			clear_bit(AS_FLAGS_SUS_PATH_STRICT, &inode->i_mapping->flags);
+		}
+	}
+	path_put(&p);
+}
+
+/* /sys/module/<name> 的包装 */
+static void susfs_hide_sysfs_mark(const char *name, bool hide)
+{
+	char path[64];
+
+	if (!name || !name[0])
+		return;
+	snprintf(path, sizeof(path), "/sys/module/%s", name);
+	susfs_hide_mark_path(path, hide);
+}
+
+/* 把名单里所有名字的 /sys/module 目录同步一遍 */
+static void susfs_hide_sysfs_sync(void)
+{
+	unsigned long flags;
+
+	char rt[SUSFS_HIDE_MODULES_RT_MAX][MODULE_NAME_LEN];
+	int nr, i;
+
+	for (i = 0; i < ARRAY_SIZE(susfs_hidden_modules); i++)
+		susfs_hide_sysfs_mark(susfs_hidden_modules[i], true);
+
+	spin_lock_irqsave(&susfs_hidden_lock, flags);
+	nr = susfs_hidden_rt_nr;
+	if (nr > SUSFS_HIDE_MODULES_RT_MAX)
+		nr = SUSFS_HIDE_MODULES_RT_MAX;
+	memcpy(rt, susfs_hidden_rt, sizeof(rt[0]) * nr);
+	spin_unlock_irqrestore(&susfs_hidden_lock, flags);
+
+	for (i = 0; i < nr; i++)
+		susfs_hide_sysfs_mark(rt[i], true);
+}
+
+/* 模块可能在开机后才 insmod：补几轮 */
+static void susfs_hide_sysfs_work(struct work_struct *w);
+static DECLARE_DELAYED_WORK(susfs_hide_sysfs_dw, susfs_hide_sysfs_work);
+static int susfs_hide_sysfs_rounds;
+
+static void susfs_hide_sysfs_work(struct work_struct *w)
+{
+	susfs_hide_sysfs_sync();
+	if (++susfs_hide_sysfs_rounds < 4)
+		schedule_delayed_work(&susfs_hide_sysfs_dw, 15 * HZ);
+}
+
+static bool susfs_hide_match(const char *name)
+{
+	unsigned long flags;
+	bool hit = false;
+	int i;
+
+	if (!name || !name[0])
+		return false;
+
+	for (i = 0; i < ARRAY_SIZE(susfs_hidden_modules); i++) {
+		if (!strcmp(name, susfs_hidden_modules[i]))
+			return true;
+	}
+
+	spin_lock_irqsave(&susfs_hidden_lock, flags);
+	for (i = 0; i < susfs_hidden_rt_nr; i++) {
+		if (!strcmp(name, susfs_hidden_rt[i])) {
+			hit = true;
+			break;
+		}
+	}
+	spin_unlock_irqrestore(&susfs_hidden_lock, flags);
+
+	return hit;
+}
+
+/* /proc/modules 的 m_show() 调用：命中就计一条 */
+bool susfs_hide_module_name(const char *name)
+{
+	if (susfs_hide_match(name)) {
+		atomic_inc(&susfs_n_mod_skipped);
+		return true;
+	}
+	return false;
+}
+
+/*
+ * 符号名过滤：处理"符号定义在别的模块里"的情况。
+ * 例：qpace_drv 的压缩函数被厂商 zram.ko 包了一层，
+ *     符号归属变成 [zram]，按模块名抓不到，只能按符号名抹。
+ * 只认 qpace 这一个前缀串，避免误伤无关符号。
+ */
+static const char *const susfs_hidden_sym_parts[] = {
+	"qpace",	/* 绿厂 QPaCE 硬件加速相关的符号；其他设备上匹配不到，无副作用 */
+};
+
+static bool susfs_hide_sym_name_match(const char *name)
+{
+	int i;
+
+	if (!name || !name[0])
+		return false;
+
+	for (i = 0; i < ARRAY_SIZE(susfs_hidden_sym_parts); i++) {
+		if (strstr(name, susfs_hidden_sym_parts[i]))
+			return true;
+	}
+	return false;
+}
+
+bool susfs_hide_symbol_name(const char *name)
+{
+	if (susfs_hide_sym_name_match(name)) {
+		atomic_inc(&susfs_n_symname_skipped);
+		return true;
+	}
+	return false;
+}
+
+/* /proc/kallsyms 的 s_show() 调用：只对模块符号计一条 */
+bool susfs_hide_module_symbol(const char *module_name)
+{
+	if (susfs_hide_match(module_name)) {
+		atomic_inc(&susfs_n_sym_skipped);
+		return true;
+	}
+	return false;
+}
+
+#ifndef SUSFS_HIDE_MODULES_NO_CTL
+
+static int susfs_hide_rt_add(const char *name)
+{
+	unsigned long flags;
+	int i, ret = 0;
+
+	if (!name || !name[0])
+		return -EINVAL;
+	if (strnlen(name, MODULE_NAME_LEN) >= MODULE_NAME_LEN)
+		return -ENAMETOOLONG;
+
+	/* 已在编译期表里：无需重复登记 */
+	for (i = 0; i < ARRAY_SIZE(susfs_hidden_modules); i++) {
+		if (!strcmp(name, susfs_hidden_modules[i]))
+			return 0;
+	}
+
+	spin_lock_irqsave(&susfs_hidden_lock, flags);
+	for (i = 0; i < susfs_hidden_rt_nr; i++) {
+		if (!strcmp(name, susfs_hidden_rt[i]))
+			goto out_unlock;
+	}
+	if (susfs_hidden_rt_nr >= SUSFS_HIDE_MODULES_RT_MAX) {
+		ret = -ENOSPC;
+		goto out_unlock;
+	}
+	strscpy(susfs_hidden_rt[susfs_hidden_rt_nr++], name, MODULE_NAME_LEN);
+out_unlock:
+	spin_unlock_irqrestore(&susfs_hidden_lock, flags);
+	if (!ret)
+		susfs_hide_sysfs_mark(name, true);	/* 进程上下文，可以 kern_path */
+	return ret;
+}
+
+static int susfs_hide_rt_del(const char *name)
+{
+	unsigned long flags;
+	int i, ret = -ENOENT;
+
+	if (!name || !name[0])
+		return -EINVAL;
+
+	spin_lock_irqsave(&susfs_hidden_lock, flags);
+	for (i = 0; i < susfs_hidden_rt_nr; i++) {
+		if (!strcmp(name, susfs_hidden_rt[i])) {
+			/* 尾部前移，保持数组紧凑 */
+			memmove(&susfs_hidden_rt[i], &susfs_hidden_rt[i + 1],
+				(size_t)(susfs_hidden_rt_nr - i - 1) * MODULE_NAME_LEN);
+			susfs_hidden_rt_nr--;
+			memset(&susfs_hidden_rt[susfs_hidden_rt_nr], 0, MODULE_NAME_LEN);
+			ret = 0;
+			break;
+		}
+	}
+	spin_unlock_irqrestore(&susfs_hidden_lock, flags);
+	if (!ret)
+		susfs_hide_sysfs_mark(name, false);
+	return ret;
+}
+
+static void susfs_hide_rt_clear(void)
+{
+	unsigned long flags;
+
+	spin_lock_irqsave(&susfs_hidden_lock, flags);
+	memset(susfs_hidden_rt, 0, sizeof(susfs_hidden_rt));
+	susfs_hidden_rt_nr = 0;
+	spin_unlock_irqrestore(&susfs_hidden_lock, flags);
+}
+
+/* ------------------------------------------------------------------
+ * 自动发现：开机扫目录建缓存 + 模块加载通知实时探测
+ *
+ * 目标：不依赖用户态脚本，也没有任何进程。
+ *   · 开机：BFS 扫 /data/adb 最多 3 层，记下可能放 .ko 的目录（上限 64）
+ *   · 之后：遍历这些目录里的 *.ko，算出模块名登记
+ *   · 运行中：register_module_notifier 捕获 insmod，按名字回探路径
+ *
+ * 失败策略：任何一步失败都只是"不隐藏"，不影响系统。
+ * ------------------------------------------------------------------ */
+
+#define KO_DIR_MAX	64
+#define KO_PATH_LEN	96
+#define KO_PEND_MAX	16
+#define KO_SCAN_DEPTH	3
+
+static char ko_dirs[KO_DIR_MAX][KO_PATH_LEN];
+static int  ko_dir_n;
+static bool ko_cache_ok;
+static DEFINE_MUTEX(ko_cache_lock);
+
+static char ko_pend[KO_PEND_MAX][MODULE_NAME_LEN];
+static int  ko_pend_n;
+static DEFINE_SPINLOCK(ko_pend_lock);
+
+/* 前向声明：probe work 会用到（定义在后面） */
+static bool ko_auto_gate(void);
+
+struct ko_bfs_ent {
+	char path[KO_PATH_LEN];
+	u8   depth;
+};
+static struct ko_bfs_ent ko_queue[KO_DIR_MAX];
+static int ko_q_head, ko_q_tail;
+
+struct ko_dir_iter {
+	struct dir_context ctx;
+	const char *parent;
+	u8 depth;
+};
+
+static bool ko_is_vendor_module(const char *name)
+{
+	char path[KO_PATH_LEN];
+	struct path p;
+
+	if (scnprintf(path, sizeof(path), "/vendor/lib/modules/%s.ko", name) >= sizeof(path))
+		return false;
+	if (kern_path(path, 0, &p) == 0) {
+		path_put(&p);
+		return true;
+	}
+	return false;
+}
+
+static int ko_cache_add(const char *path)
+{
+	int i;
+
+	for (i = 0; i < ko_dir_n; i++)
+		if (!strcmp(ko_dirs[i], path))
+			return 0;
+	if (ko_dir_n >= KO_DIR_MAX)
+		return -ENOSPC;
+	strscpy(ko_dirs[ko_dir_n], path, KO_PATH_LEN);
+	ko_dir_n++;
+	return 0;
+}
+
+static struct file *ko_open_dir(const char *path)
+{
+	return filp_open(path, O_RDONLY | O_DIRECTORY | O_NOFOLLOW, 0);
+}
+
+/* 收集子目录进 BFS 队列 */
+static bool ko_dirs_actor(struct dir_context *ctx, const char *name, int namelen,
+			  loff_t pos, u64 ino, unsigned type)
+{
+	struct ko_dir_iter *it = container_of(ctx, struct ko_dir_iter, ctx);
+	struct ko_bfs_ent *e;
+	int len;
+
+	if (type != DT_DIR || namelen <= 0 || name[0] == '.')
+		return true;
+	if (ko_q_tail >= KO_DIR_MAX)
+		return false;
+
+	e = &ko_queue[ko_q_tail];
+	len = scnprintf(e->path, KO_PATH_LEN, "%s/%.*s", it->parent, namelen, name);
+	if (len <= 0 || len >= KO_PATH_LEN)
+		return true;
+	e->depth = it->depth + 1;
+	ko_q_tail++;
+	return true;
+}
+
+/*
+ * 注意：dir_context 的 actor 跑在文件系统的目录遍历里（持有 inode 锁），
+ * 回调里绝对不能调用 kern_path / rt_add 这类可能睡眠的函数，否则可能死锁。
+ * 所以这里只把名字抄进缓冲，真正的登记放到 iterate_dir 返回之后。
+ */
+struct ko_file_iter {
+	struct dir_context ctx;
+	char (*names)[MODULE_NAME_LEN];
+	int max;
+	int nr;
+};
+
+static bool ko_files_actor(struct dir_context *ctx, const char *name, int namelen,
+			   loff_t pos, u64 ino, unsigned type)
+{
+	struct ko_file_iter *it = container_of(ctx, struct ko_file_iter, ctx);
+	char *slot;
+	int i, n = 0;
+
+	if (type != DT_REG && type != DT_UNKNOWN)
+		return true;
+	if (namelen <= 3 || strncmp(name + namelen - 3, ".ko", 3))
+		return true;
+	if (it->nr >= it->max)
+		return true;
+
+	slot = it->names[it->nr];
+	for (i = 0; i < namelen - 3 && n < MODULE_NAME_LEN - 1; i++)
+		slot[n++] = (name[i] == '-') ? '_' : name[i];
+	slot[n] = '\0';
+	if (n > 0)
+		it->nr++;
+	return true;
+}
+
+/* 调用者须持有 ko_cache_lock */
+static void ko_cache_build_locked(void)
+{
+	struct ko_dir_iter it;
+	struct file *f;
+
+	ko_dir_n = 0;
+	ko_q_head = 0;
+	ko_q_tail = 0;
+
+	strscpy(ko_queue[0].path, "/data/adb", KO_PATH_LEN);
+	ko_queue[0].depth = 0;
+	ko_q_tail = 1;
+
+	while (ko_q_head < ko_q_tail) {
+		struct ko_bfs_ent e = ko_queue[ko_q_head++];
+
+		if (ko_cache_add(e.path))
+			break;
+		if (e.depth >= KO_SCAN_DEPTH)
+			continue;
+
+		f = ko_open_dir(e.path);
+		if (IS_ERR(f))
+			continue;
+		memset(&it, 0, sizeof(it));
+		it.ctx.actor = ko_dirs_actor;
+		it.parent = e.path;
+		it.depth = e.depth;
+		iterate_dir(f, &it.ctx);
+		filp_close(f, NULL);
+	}
+}
+
+/* 调用者须持有 ko_cache_lock */
+static void ko_cache_ensure_locked(void)
+{
+	if (ko_cache_ok)
+		return;
+	ko_cache_build_locked();
+	ko_cache_ok = (ko_dir_n > 0);
+}
+
+static bool ko_probe_name(const char *name)
+{
+	char path[KO_PATH_LEN];
+	struct path p;
+	int i;
+
+	for (i = 0; i < ko_dir_n; i++) {
+		if (scnprintf(path, sizeof(path), "%s/%s.ko", ko_dirs[i], name) >= sizeof(path))
+			continue;
+		if (kern_path(path, 0, &p) == 0) {
+			path_put(&p);
+			return true;
+		}
+	}
+	return false;
+}
+
+/* 开机扫一遍缓存目录里的 *.ko：先收集名字，再在遍历之外登记 */
+static void ko_boot_scan(void)
+{
+	struct ko_file_iter it;
+	struct file *f;
+	int i, j;
+
+	it.names = kcalloc(KO_DIR_MAX, MODULE_NAME_LEN, GFP_KERNEL);
+	if (!it.names)
+		return;
+	it.max = KO_DIR_MAX;
+
+	mutex_lock(&ko_cache_lock);
+	ko_cache_ensure_locked();
+	for (i = 0; i < ko_dir_n; i++) {
+		f = ko_open_dir(ko_dirs[i]);
+		if (IS_ERR(f))
+			continue;
+		it.nr = 0;
+		memset(&it.ctx, 0, sizeof(it.ctx));
+		it.ctx.actor = ko_files_actor;
+		iterate_dir(f, &it.ctx);
+		filp_close(f, NULL);
+
+		/* 遍历已经结束，这里可以安全地做路径查找 */
+		for (j = 0; j < it.nr; j++) {
+			if (ko_is_vendor_module(it.names[j]))
+				continue;
+			(void)susfs_hide_rt_add(it.names[j]);
+		}
+	}
+	mutex_unlock(&ko_cache_lock);
+	kfree(it.names);
+}
+
+static void ko_probe_work_fn(struct work_struct *w)
+{
+	char names[KO_PEND_MAX][MODULE_NAME_LEN];
+	unsigned long flags;
+	int i, n;
+
+	spin_lock_irqsave(&ko_pend_lock, flags);
+	n = ko_pend_n;
+	if (n)
+		memcpy(names, ko_pend, sizeof(names[0]) * (size_t)n);
+	ko_pend_n = 0;
+	spin_unlock_irqrestore(&ko_pend_lock, flags);
+	if (!n)
+		return;
+	if (!ko_auto_gate())
+		return;
+
+	mutex_lock(&ko_cache_lock);
+	ko_cache_ensure_locked();
+	for (i = 0; i < n; i++) {
+		if (ko_is_vendor_module(names[i]))
+			continue;
+		if (ko_probe_name(names[i])) {
+			atomic_inc(&ko_n_probe_hits);
+			(void)susfs_hide_rt_add(names[i]);
+		} else {
+			atomic_inc(&ko_n_probe_miss);
+		}
+	}
+	mutex_unlock(&ko_cache_lock);
+}
+static DECLARE_WORK(ko_probe_work, ko_probe_work_fn);
+
+static int ko_module_notify(struct notifier_block *nb, unsigned long event, void *data)
+{
+	struct module *mod = data;
+	unsigned long flags;
+	int i;
+
+	if (event != MODULE_STATE_COMING || !mod || !mod->name[0])
+		return NOTIFY_DONE;
+
+	atomic_inc(&ko_n_notify);
+
+	/* notifier 里处在模块加载上下文（持有 module_mutex），只入队不做事 */
+	spin_lock_irqsave(&ko_pend_lock, flags);
+	for (i = 0; i < ko_pend_n; i++) {
+		if (!strcmp(ko_pend[i], mod->name)) {
+			spin_unlock_irqrestore(&ko_pend_lock, flags);
+			return NOTIFY_DONE;
+		}
+	}
+	if (ko_pend_n < KO_PEND_MAX)
+		strscpy(ko_pend[ko_pend_n++], mod->name, MODULE_NAME_LEN);
+	spin_unlock_irqrestore(&ko_pend_lock, flags);
+
+	schedule_work(&ko_probe_work);
+	return NOTIFY_DONE;
+}
+
+static struct notifier_block ko_module_nb = {
+	.notifier_call = ko_module_notify,
+};
+
+/*
+ * 自动发现的开关：默认关闭。
+ *   · 建一个 /data/adb/hide-ko/auto 文件即可启用（恢复模式下也能删掉它）
+ *   · 或者 echo "scan on" > /proc/oplus_mem_zone
+ * 这样即使自动发现的代码有问题，首刷也不会卡开机。
+ */
+static bool ko_auto_enabled;
+
+static bool ko_auto_gate(void)
+{
+	struct path p;
+
+	if (ko_auto_enabled)
+		return true;
+	if (kern_path("/data/adb/hide-ko/auto", 0, &p) == 0) {
+		path_put(&p);
+		ko_auto_enabled = true;
+		return true;
+	}
+	return false;
+}
+
+static void ko_boot_work_fn(struct work_struct *w);
+static DECLARE_DELAYED_WORK(ko_boot_dw, ko_boot_work_fn);
+static int ko_boot_rounds;
+
+static void ko_boot_work_fn(struct work_struct *w)
+{
+	/* 没启用就只做重试，不碰文件系统（首刷安全） */
+	if (!ko_auto_gate()) {
+		if (++ko_boot_rounds < 8)
+			schedule_delayed_work(&ko_boot_dw, 15 * HZ);
+		return;
+	}
+	ko_boot_scan();
+	if (!ko_cache_ok && ++ko_boot_rounds < 4)
+		schedule_delayed_work(&ko_boot_dw, 15 * HZ);
+}
+
+static int susfs_hide_show(struct seq_file *m, void *v)
+{
+	unsigned long flags;
+	int i;
+
+	seq_puts(m, "compiled:");
+	for (i = 0; i < ARRAY_SIZE(susfs_hidden_modules); i++)
+		seq_printf(m, " %s", susfs_hidden_modules[i]);
+	seq_puts(m, "\n");
+
+	spin_lock_irqsave(&susfs_hidden_lock, flags);
+	seq_printf(m, "runtime (%d/%d):", susfs_hidden_rt_nr,
+		   SUSFS_HIDE_MODULES_RT_MAX);
+	for (i = 0; i < susfs_hidden_rt_nr; i++)
+		seq_printf(m, " %s", susfs_hidden_rt[i]);
+	spin_unlock_irqrestore(&susfs_hidden_lock, flags);
+	seq_puts(m, "\n");
+
+	seq_printf(m, "skipped: modules_lines=%d kallsyms_lines=%d symbolname=%d sysfs_marked=%d\n",
+		   atomic_read(&susfs_n_mod_skipped),
+		   atomic_read(&susfs_n_sym_skipped),
+		   atomic_read(&susfs_n_symname_skipped),
+		   atomic_read(&susfs_n_sysfs_marked));
+	seq_printf(m, "auto: %s dirs=%d cache=%s probe_hits=%d probe_miss=%d notify=%d\n",
+		   ko_auto_enabled ? "on" : "off",
+		   ko_dir_n, ko_cache_ok ? "ok" : "no",
+		   atomic_read(&ko_n_probe_hits),
+		   atomic_read(&ko_n_probe_miss),
+		   atomic_read(&ko_n_notify));
+
+	return 0;
+}
+
+static int susfs_hide_open(struct inode *inode, struct file *file)
+{
+	if (!capable(CAP_SYS_ADMIN))
+		return -EPERM;
+	return single_open(file, susfs_hide_show, NULL);
+}
+
+static ssize_t susfs_hide_write(struct file *file, const char __user *ubuf,
+				size_t count, loff_t *ppos)
+{
+	char cmd[128], *op, *arg;
+	int ret;
+
+	if (!capable(CAP_SYS_ADMIN))
+		return -EPERM;
+	if (count == 0)
+		return 0;
+	if (count >= sizeof(cmd))
+		return -EINVAL;
+	if (copy_from_user(cmd, ubuf, count))
+		return -EFAULT;
+	cmd[count] = '\0';
+	strim(cmd);
+
+	if (!cmd[0])
+		return 0;
+
+	op = cmd;
+	arg = strchr(cmd, ' ');
+	if (arg) {
+		*arg++ = '\0';
+		arg = skip_spaces(arg);
+	}
+
+	if (!strcmp(op, "clear") && !arg) {
+		susfs_hide_rt_clear();
+		return count;
+	}
+	if (!strcmp(op, "add")) {
+		ret = susfs_hide_rt_add(arg);
+		return ret ? ret : count;
+	}
+	if (!strcmp(op, "del")) {
+		ret = susfs_hide_rt_del(arg);
+		return ret ? ret : count;
+	}
+	if (!strcmp(op, "scan")) {
+		if (arg && !strcmp(arg, "on")) {
+			ko_auto_enabled = true;
+			ko_boot_rounds = 0;
+			schedule_delayed_work(&ko_boot_dw, 2 * HZ);
+			return count;
+		}
+		if (arg && !strcmp(arg, "off")) {
+			ko_auto_enabled = false;
+			return count;
+		}
+		return -EINVAL;
+	}
+
+	/* 裸名字等同 add，方便脚本一次写一行 */
+	return susfs_hide_rt_add(op) ? -EINVAL : count;
+}
+
+static const struct proc_ops susfs_hide_proc_ops = {
+	.proc_open	= susfs_hide_open,
+	.proc_read	= seq_read,
+	.proc_lseek	= seq_lseek,
+	.proc_release	= single_release,
+	.proc_write	= susfs_hide_write,
+};
+
+static int __init susfs_hide_modules_init(void)
+{
+	if (!proc_create("oplus_mem_zone", 0600, NULL, &susfs_hide_proc_ops))
+		pr_warn("susfs_hide_modules: /proc node not created\n");
+	/* 开机后模块才 insmod，这里补几轮 /sys/module 规则 */
+	schedule_delayed_work(&susfs_hide_sysfs_dw, 10 * HZ);
+
+	/* 自动发现：insmod 时立即探测，开机 10 秒后再整体扫一遍 */
+	register_module_notifier(&ko_module_nb);
+	schedule_delayed_work(&ko_boot_dw, 10 * HZ);
+	return 0;
+}
+/* late_initcall：确保 procfs 的 root 已就绪再建节点 */
+late_initcall(susfs_hide_modules_init);
+
+#endif /* SUSFS_HIDE_MODULES_NO_CTL */
